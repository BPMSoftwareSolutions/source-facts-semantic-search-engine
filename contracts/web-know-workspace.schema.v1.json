{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Web Know-How Workspace Policy",
  "type": "object",
  "required": [
    "policyType",
    "roots",
    "entryExtensions",
    "relatedExtensions",
    "excludeDirectories",
    "symlinkPolicy",
    "maxFileSizeBytes",
    "expansion"
  ],
  "additionalProperties": false,
  "properties": {
    "policyType": { "const": "web-know-workspace.v1" },
    "roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rootId", "path"],
        "additionalProperties": false,
        "properties": {
          "rootId": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "entryExtensions": {
      "type": "array",
      "items": { "type": "string", "pattern": "^\\.[a-z0-9]+$" }
    },
    "relatedExtensions": {
      "type": "array",
      "items": { "type": "string", "pattern": "^\\.[a-z0-9]+$" }
    },
    "excludeDirectories": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "excludeGlobs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "generatedGlobs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "evidenceSnapshotGlobs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "symlinkPolicy": { "enum": ["skip", "follow"] },
    "maxFileSizeBytes": { "type": "integer", "minimum": 1 },
    "expansion": {
      "type": "object",
      "required": ["maxDepth", "maxMembers", "maxBytes", "maxTimeMs"],
      "additionalProperties": false,
      "properties": {
        "maxDepth": { "type": "integer", "minimum": 0 },
        "maxMembers": { "type": "integer", "minimum": 1 },
        "maxBytes": { "type": "integer", "minimum": 1 },
        "maxTimeMs": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
