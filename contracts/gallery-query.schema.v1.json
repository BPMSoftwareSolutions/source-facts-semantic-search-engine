{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gallery Saved Query",
  "type": "object",
  "required": ["declarationType", "queryId", "sourceCollection", "commandText", "description", "requiredColumns", "allowedProjectorIds"],
  "additionalProperties": false,
  "properties": {
    "declarationType": { "const": "gallery-query.v1" },
    "queryId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "sourceCollection": { "type": "string", "minLength": 1 },
    "commandText": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "requiredColumns": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "allowedProjectorIds": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  }
}
