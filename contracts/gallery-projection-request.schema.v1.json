{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gallery Projection Request",
  "type": "object",
  "required": [
    "requestType",
    "requestId",
    "inventoryId",
    "webSurfaceIndexId",
    "savedQueryId",
    "queryText",
    "queryHash",
    "projectorId",
    "projectorAuthorityHash",
    "previewPolicyId",
    "previewPolicyHash",
    "sortColumns",
    "limit",
    "emptyResultPosture",
    "outputDirectory",
    "writeMode",
    "redactionProfile"
  ],
  "additionalProperties": false,
  "properties": {
    "requestType": { "const": "gallery-projection-request.v1" },
    "requestId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "inventoryId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "webSurfaceIndexId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "savedQueryId": { "type": ["string", "null"] },
    "queryText": { "type": "string", "minLength": 1 },
    "queryHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "projectorId": { "type": "string", "minLength": 1 },
    "projectorAuthorityHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "previewPolicyId": { "type": "string", "minLength": 1 },
    "previewPolicyHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sortColumns": { "type": "array", "items": { "type": "string" } },
    "limit": { "type": ["integer", "null"], "minimum": 0 },
    "emptyResultPosture": { "enum": ["empty-manifest"] },
    "outputDirectory": { "type": "string", "minLength": 1 },
    "writeMode": { "enum": ["overwrite", "fail-if-exists"] },
    "redactionProfile": { "type": "string", "minLength": 1 }
  }
}
