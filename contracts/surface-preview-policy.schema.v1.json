{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Surface Preview Policy",
  "type": "object",
  "required": [
    "declarationType",
    "policyId",
    "scriptPolicy",
    "networkPolicy",
    "formPolicy",
    "navigationPolicy",
    "downloadPolicy",
    "storagePolicy",
    "serviceWorkerPolicy",
    "permissionPolicy",
    "sandboxTokens",
    "viewports",
    "maxBytes",
    "maxFiles",
    "timeoutMs"
  ],
  "additionalProperties": false,
  "properties": {
    "declarationType": { "const": "surface-preview-policy.v1" },
    "policyId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.v[0-9]+$" },
    "scriptPolicy": { "enum": ["deny", "governed-allowlist"] },
    "networkPolicy": { "enum": ["deny", "mock-only", "origin-allowlist"] },
    "formPolicy": { "const": "deny" },
    "navigationPolicy": { "const": "deny" },
    "downloadPolicy": { "const": "deny" },
    "storagePolicy": { "const": "ephemeral-deny-by-default" },
    "serviceWorkerPolicy": { "const": "block" },
    "permissionPolicy": { "const": "none" },
    "sandboxTokens": { "type": "array", "items": { "type": "string" } },
    "viewports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["label", "width", "height"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "maxBytes": { "type": "integer", "minimum": 1 },
    "maxFiles": { "type": "integer", "minimum": 1 },
    "timeoutMs": { "type": "integer", "minimum": 1 }
  }
}
