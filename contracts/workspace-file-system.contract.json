    { "directoryId": "artifacts-directory", "relativePath": "artifacts", "required": false },
    { "directoryId": "artifacts-indexes-directory", "relativePath": "artifacts/indexes", "required": false },
    { "directoryId": "artifacts-call-graphs-directory", "relativePath": "artifacts/call-graphs", "required": false },
    { "directoryId": "artifacts-governance-directory", "relativePath": "artifacts/governance", "required": false },
    { "directoryId": "artifacts-governance-self-report-receipts-directory", "relativePath": "artifacts/governance/source-facts-self-governance-report.receipts", "required": false },

    { "directoryId": "evidence-directory", "relativePath": "evidence", "required": false },
    { "directoryId": "evidence-know-how-directory", "relativePath": "evidence/know-how", "required": false },
    { "directoryId": "evidence-know-how-authority-candidates-directory", "relativePath": "evidence/know-how/authority-remediation-candidates", "required": false },
    { "directoryId": "evidence-healing-directory", "relativePath": "evidence/healing", "required": false },
    { "directoryId": "evidence-reviews-directory", "relativePath": "evidence/reviews", "required": false },
    { "directoryId": "evidence-reviews-live-evaluations-directory", "relativePath": "evidence/reviews/live-evaluations", "required": false },

    { "directoryId": "scripts-proofs-directory", "relativePath": "scripts/proofs", "required": false }
