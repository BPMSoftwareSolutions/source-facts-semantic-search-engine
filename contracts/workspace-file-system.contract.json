  "artifactFamilies": [
    { "familyId": "artifacts-index-files", "pathPattern": "artifacts/indexes/**/*", "artifactKind": "source-fact-index", "cardinality": { "min": 0 } },
    { "familyId": "artifacts-call-graph-files", "pathPattern": "artifacts/call-graphs/**/*", "artifactKind": "call-graph", "cardinality": { "min": 0 } },
    { "familyId": "artifacts-governance-files", "pathPattern": "artifacts/governance/**/*", "artifactKind": "governance-report", "cardinality": { "min": 0 } },
