      "governedDirectories": ["artifacts", "contracts", "docs", "evidence", "scripts", "source-facts-query-console", "src", "test"],
      "outsideScopePosture": "outside-authority"
    },
    "unexpectedPaths": { "policy": "reject" }
  },
  "directories": [
    { "directoryId": "contracts-directory", "relativePath": "contracts", "required": true },
    { "directoryId": "contracts-composition-authorities-directory", "relativePath": "contracts/composition-authorities", "required": true },
    { "directoryId": "contracts-compositions-directory", "relativePath": "contracts/compositions", "required": true },
    { "directoryId": "contracts-gallery-policies-directory", "relativePath": "contracts/gallery-policies", "required": true },
