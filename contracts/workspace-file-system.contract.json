    { "familyId": "contracts-files", "pathPattern": "contracts/**/*", "artifactKind": "contract-artifact", "cardinality": { "min": 1 } },
    { "familyId": "docs-files", "pathPattern": "docs/**/*", "artifactKind": "documentation", "cardinality": { "min": 1 } },
    { "familyId": "scripts-files", "pathPattern": "scripts/**/*", "artifactKind": "script", "cardinality": { "min": 1 } },
    { "familyId": "source-facts-query-console-files", "pathPattern": "source-facts-query-console/**/*", "artifactKind": "console-source", "cardinality": { "min": 1 } },
    { "familyId": "src-files", "pathPattern": "src/**/*", "artifactKind": "engine-source", "cardinality": { "min": 1 } },
    { "familyId": "src-console-governance-files", "pathPattern": "src/console/.governance/**/*", "artifactKind": "governance-ledger", "cardinality": { "min": 1 } },
    { "familyId": "test-files", "pathPattern": "test/**/*", "artifactKind": "test", "cardinality": { "min": 1 } }
  ]
