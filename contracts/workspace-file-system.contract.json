    { "directoryId": "docs-skills-project-authority-candidates-from-mechanics-directory", "relativePath": "docs/skills/project-authority-candidates-from-mechanics", "required": true },
    { "directoryId": "docs-skills-query-source-facts-before-reading-code-directory", "relativePath": "docs/skills/query-source-facts-before-reading-code", "required": true },
    { "directoryId": "docs-skills-verify-capability-is-operational-directory", "relativePath": "docs/skills/verify-capability-is-operational", "required": true },

    { "directoryId": "scripts-directory", "relativePath": "scripts", "required": true },
    { "directoryId": "scripts-sql-directory", "relativePath": "scripts/sql", "required": true },

    { "directoryId": "source-facts-query-console-directory", "relativePath": "source-facts-query-console", "required": true },
