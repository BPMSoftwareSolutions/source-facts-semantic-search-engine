    { "directoryId": "src-console-governed-message-artifact-family-src-directory", "relativePath": "src/console/governed-message-artifact-family/src", "required": true },
    { "directoryId": "src-console-governed-message-artifact-family-verification-directory", "relativePath": "src/console/governed-message-artifact-family/verification", "required": true },
    { "directoryId": "src-gallery-directory", "relativePath": "src/gallery", "required": true },
    { "directoryId": "src-lib-directory", "relativePath": "src/lib", "required": true },
