{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Web Know-How Landing Page Contract",
  "type": "object",
  "required": ["contractType", "contractId", "sessionId", "subject", "purpose", "audience", "pageRegions", "selectedLayout"],
  "additionalProperties": false,
  "properties": {
    "contractType": { "const": "web-know-landing-page-contract.v1" },
    "contractId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sessionId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "subject": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "pageRegions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["regionId", "name", "parentRegionId", "depth", "reusedKnowHow", "notes"],
        "properties": {
          "regionId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "name": { "type": "string", "minLength": 1 },
          "parentRegionId": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
          "depth": { "type": "integer", "minimum": 0 },
          "reusedKnowHow": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "evidenceReferences"],
              "properties": {
                "label": { "type": "string", "minLength": 1 },
                "evidenceReferences": { "type": "array", "items": { "type": "string" } }
              },
              "additionalProperties": false
            }
          },
          "notes": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "selectedLayout": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["label", "rationale"],
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "rationale": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
