{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source Facts Self-Governance Report",
  "type": "object",
  "required": [
    "reportType",
    "generatedAtUtc",
    "repository",
    "index",
    "authoritySources",
    "otherAuthorityDocuments",
    "executionMechanics",
    "fileBreakdown",
    "dataDrivenWiring",
    "contractSemanticVolume",
    "occurrences",
    "disposition"
  ],
  "additionalProperties": false,
  "$defs": {
    "posture": {
      "enum": [
        "GOVERNED_BY_SEMANTIC_AUTHORITY",
        "MECHANICAL_ADAPTER_OPERATION",
        "KERNEL_PRIMITIVE",
        "AUTHORIZED_TEMPORARY_BACKLOG",
        "UNAUTHORIZED_EXECUTABLE_MEANING",
        "UNKNOWN_CLASSIFICATION"
      ]
    },
    "authorityHomeStatus": {
      "enum": [
        "AUTHORITY_HOME_EXISTS",
        "AUTHORITY_HOME_EXISTS_BUT_INCOMPLETE",
        "AUTHORITY_HOME_MISSING",
        "AUTHORITY_HOME_AMBIGUOUS"
      ]
    }
  },
  "properties": {
    "reportType": { "const": "source-facts-self-governance-report.v1" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "repository": {
      "type": "object",
      "required": ["repositoryId", "workspaceId", "workspaceRoot"],
      "additionalProperties": false,
      "properties": {
        "repositoryId": { "type": "string", "minLength": 1 },
        "workspaceId": { "type": ["string", "null"] },
        "workspaceRoot": { "type": ["string", "null"] }
      }
    },
    "index": {
      "type": "object",
      "required": ["indexId", "scanId"],
      "additionalProperties": false,
      "properties": {
        "indexId": { "type": ["string", "null"] },
        "scanId": { "type": ["string", "null"] }
      }
    },
    "authoritySources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["authorityFile", "sourceFile", "mechanicsDeclared", "mechanicsAuthorityBound"],
        "additionalProperties": false,
        "properties": {
          "authorityFile": { "type": "string", "minLength": 1 },
          "sourceFile": { "type": ["string", "null"] },
          "mechanicsDeclared": { "type": "integer", "minimum": 0 },
          "mechanicsAuthorityBound": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "otherAuthorityDocuments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["authorityFile", "documentKind", "claimedFiles"],
        "additionalProperties": false,
        "properties": {
          "authorityFile": { "type": "string", "minLength": 1 },
          "documentKind": { "type": "string", "minLength": 1 },
          "claimedFiles": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "executionMechanics": {
      "type": "object",
      "required": ["observed", "governed", "byPosture", "byMechanicType"],
      "additionalProperties": false,
      "properties": {
        "observed": { "type": "integer", "minimum": 0 },
        "governed": { "type": "integer", "minimum": 0 },
        "byPosture": {
          "type": "object",
          "required": [
            "GOVERNED_BY_SEMANTIC_AUTHORITY",
            "MECHANICAL_ADAPTER_OPERATION",
            "KERNEL_PRIMITIVE",
            "AUTHORIZED_TEMPORARY_BACKLOG",
            "UNAUTHORIZED_EXECUTABLE_MEANING",
            "UNKNOWN_CLASSIFICATION"
          ],
          "additionalProperties": false,
          "properties": {
            "GOVERNED_BY_SEMANTIC_AUTHORITY": { "type": "integer", "minimum": 0 },
            "MECHANICAL_ADAPTER_OPERATION": { "type": "integer", "minimum": 0 },
            "KERNEL_PRIMITIVE": { "type": "integer", "minimum": 0 },
            "AUTHORIZED_TEMPORARY_BACKLOG": { "type": "integer", "minimum": 0 },
            "UNAUTHORIZED_EXECUTABLE_MEANING": { "type": "integer", "minimum": 0 },
            "UNKNOWN_CLASSIFICATION": { "type": "integer", "minimum": 0 }
          }
        },
        "byMechanicType": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["mechanic", "authorityFamily", "observed", "governed", "files", "byHomeStatus"],
            "additionalProperties": false,
            "properties": {
              "mechanic": { "type": "string", "minLength": 1 },
              "authorityFamily": { "type": "string", "minLength": 1 },
              "observed": { "type": "integer", "minimum": 0 },
              "governed": { "type": "integer", "minimum": 0 },
              "files": { "type": "integer", "minimum": 0 },
              "byHomeStatus": {
                "type": "object",
                "required": [
                  "AUTHORITY_HOME_EXISTS",
                  "AUTHORITY_HOME_EXISTS_BUT_INCOMPLETE",
                  "AUTHORITY_HOME_MISSING",
                  "AUTHORITY_HOME_AMBIGUOUS"
                ],
                "additionalProperties": false,
                "properties": {
                  "AUTHORITY_HOME_EXISTS": { "type": "integer", "minimum": 0 },
                  "AUTHORITY_HOME_EXISTS_BUT_INCOMPLETE": { "type": "integer", "minimum": 0 },
                  "AUTHORITY_HOME_MISSING": { "type": "integer", "minimum": 0 },
                  "AUTHORITY_HOME_AMBIGUOUS": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        }
      }
    },
    "dataDrivenWiring": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "modulePath",
          "importsContractData",
          "invokesSemanticRuntime",
          "transitiveContractPaths",
          "transitiveRuntimePaths",
          "hopCount",
          "hopPath",
          "wiringDisposition"
        ],
        "additionalProperties": false,
        "properties": {
          "modulePath": { "type": "string", "minLength": 1 },
          "importsContractData": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "invokesSemanticRuntime": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "transitiveContractPaths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "transitiveRuntimePaths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "hopCount": { "type": ["integer", "null"], "minimum": 1 },
          "hopPath": { "type": ["array", "null"], "items": { "type": "string", "minLength": 1 } },
          "wiringDisposition": {
            "enum": [
              "DIRECT_DATA_AND_RUNTIME",
              "RUNTIME_ONLY",
              "DATA_ONLY",
              "TRANSITIVE_DATA_AND_RUNTIME",
              "TRANSITIVE_RUNTIME_ONLY",
              "TRANSITIVE_DATA_ONLY",
              "NOT_DETERMINED_BEYOND_MAX_DEPTH",
              "NONE"
            ]
          }
        }
      }
    },
    "contractSemanticVolume": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "authorityFile",
          "documentKind",
          "semanticElementCounts",
          "totalSemanticElements",
          "reachableSemanticElements",
          "orphanedSemanticElements",
          "undeterminedSemanticElements",
          "mechanicReachability",
          "artifactReachability"
        ],
        "additionalProperties": false,
        "properties": {
          "authorityFile": { "type": "string", "minLength": 1 },
          "documentKind": { "type": "string", "minLength": 1 },
          "semanticElementCounts": {
            "type": "object",
            "required": ["decisions", "semanticEdges", "failurePolicies", "projectionMappings", "resultContracts", "responsibilities", "declarations", "mechanics"],
            "additionalProperties": false,
            "properties": {
              "decisions": { "type": "integer", "minimum": 0 },
              "semanticEdges": { "type": "integer", "minimum": 0 },
              "failurePolicies": { "type": "integer", "minimum": 0 },
              "projectionMappings": { "type": "integer", "minimum": 0 },
              "resultContracts": { "type": "integer", "minimum": 0 },
              "responsibilities": { "type": "integer", "minimum": 0 },
              "declarations": { "type": "integer", "minimum": 0 },
              "mechanics": { "type": "integer", "minimum": 0 }
            }
          },
          "totalSemanticElements": { "type": "integer", "minimum": 0 },
          "reachableSemanticElements": { "type": "integer", "minimum": 0 },
          "orphanedSemanticElements": { "type": "integer", "minimum": 0 },
          "undeterminedSemanticElements": { "type": "integer", "minimum": 0 },
          "mechanicReachability": {
            "type": ["object", "null"],
            "required": ["total", "resolved", "unresolved", "ambiguous", "byStatus"],
            "additionalProperties": false,
            "properties": {
              "total": { "type": "integer", "minimum": 0 },
              "resolved": { "type": "integer", "minimum": 0 },
              "unresolved": { "type": "integer", "minimum": 0 },
              "ambiguous": { "type": "integer", "minimum": 0 },
              "byStatus": {
                "type": "object",
                "required": ["RESOLVED", "RESOLVED_BY_SUFFIX", "MOVED_OR_REMOVED", "AMBIGUOUS", "UNRESOLVABLE_LOCATION"],
                "additionalProperties": false,
                "properties": {
                  "RESOLVED": { "type": "integer", "minimum": 0 },
                  "RESOLVED_BY_SUFFIX": { "type": "integer", "minimum": 0 },
                  "MOVED_OR_REMOVED": { "type": "integer", "minimum": 0 },
                  "AMBIGUOUS": { "type": "integer", "minimum": 0 },
                  "UNRESOLVABLE_LOCATION": { "type": "integer", "minimum": 0 }
                }
              }
            }
          },
          "artifactReachability": {
            "type": ["array", "null"],
            "items": {
              "type": "object",
              "required": ["artifactId", "relativePath", "reachable", "semanticElementCount"],
              "additionalProperties": false,
              "properties": {
                "artifactId": { "type": ["string", "null"] },
                "relativePath": { "type": ["string", "null"] },
                "reachable": { "type": "boolean" },
                "semanticElementCount": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "fileBreakdown": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["mechanic", "modulePath", "authorityFamily", "occurrenceCount", "governedCount", "responsibilities", "homeStatus", "authorityFile", "authorityHomeVerified"],
        "additionalProperties": false,
        "properties": {
          "mechanic": { "type": "string", "minLength": 1 },
          "modulePath": { "type": "string", "minLength": 1 },
          "authorityFamily": { "type": "string", "minLength": 1 },
          "occurrenceCount": { "type": "integer", "minimum": 1 },
          "governedCount": { "type": "integer", "minimum": 0 },
          "responsibilities": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "homeStatus": { "$ref": "#/$defs/authorityHomeStatus" },
          "authorityFile": { "type": ["string", "null"] },
          "authorityHomeVerified": { "type": "boolean" }
        }
      }
    },
    "occurrences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "mechanic",
          "modulePath",
          "startLine",
          "endLine",
          "symbolName",
          "posture",
          "governingMechanicId",
          "governingAuthorityFile",
          "authorityFamily",
          "authorityHomeStatus",
          "authorityHomeFile",
          "authorityHomeVerified"
        ],
        "additionalProperties": false,
        "properties": {
          "mechanic": { "type": "string", "minLength": 1 },
          "modulePath": { "type": "string" },
          "startLine": { "type": ["integer", "null"] },
          "endLine": { "type": ["integer", "null"] },
          "symbolName": { "type": ["string", "null"] },
          "posture": { "$ref": "#/$defs/posture" },
          "governingMechanicId": { "type": ["string", "null"] },
          "governingAuthorityFile": { "type": ["string", "null"] },
          "authorityFamily": { "type": "string", "minLength": 1 },
          "authorityHomeStatus": { "$ref": "#/$defs/authorityHomeStatus" },
          "authorityHomeFile": { "type": ["string", "null"] },
          "authorityHomeVerified": { "type": "boolean" }
        }
      }
    },
    "disposition": { "const": "OBSERVATIONAL_NO_GATE_APPLIED" }
  }
}
