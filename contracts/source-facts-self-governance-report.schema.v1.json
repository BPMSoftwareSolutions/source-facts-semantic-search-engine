{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source Facts Self-Governance Report",
  "type": "object",
  "required": [
    "reportType",
    "generatedAtUtc",
    "repository",
    "index",
    "subjectScope",
    "scenarioConformance",
    "featureCoverage",
    "unclassifiedInventory",
    "authoritySources",
    "otherAuthorityDocuments",
    "executionMechanics",
    "fileBreakdown",
    "dataDrivenWiring",
    "contractSemanticVolume",
    "authoritySuccession",
    "semanticOverlapProposals",
    "knowHowRegistry",
    "healingDraftRegistry",
    "automationReadiness",
    "occurrences",
    "queryLineage",
    "disposition"
  ],
  "additionalProperties": false,
  "$defs": {
    "posture": {
      "enum": [
        "GOVERNED_BY_SEMANTIC_AUTHORITY",
        "MECHANICAL_ADAPTER_OPERATION",
        "KERNEL_PRIMITIVE",
        "AUTHORIZED_TEMPORARY_BACKLOG",
        "UNAUTHORIZED_EXECUTABLE_MEANING",
        "UNKNOWN_CLASSIFICATION"
      ]
    },
    "authorityHomeStatus": {
      "enum": [
        "AUTHORITY_HOME_EXISTS",
        "AUTHORITY_HOME_EXISTS_BUT_INCOMPLETE",
        "AUTHORITY_HOME_MISSING",
        "AUTHORITY_HOME_AMBIGUOUS"
      ]
    },
    "automationDisposition": {
      "enum": [
        "ALREADY_GOVERNED",
        "NOT_APPLICABLE",
        "AUTOMATABLE_AFTER_REVIEW",
        "REQUIRES_HUMAN_SEMANTIC_DECISION",
        "AUTOMATABLE_AFTER_AUTHORITY_COMPLETION",
        "REQUIRES_NEW_AUTHORITY",
        "NOT_CURRENTLY_PROJECTABLE"
      ]
    },
    "missingTissue": {
      "enum": [
        "AUTHORITY_DOCUMENT_MISSING",
        "AUTHORITY_FAMILY_MISSING",
        "AUTHORITY_ENTRY_MISSING",
        "AUTHORITY_HOME_AMBIGUOUS",
        "RESPONSIBILITY_BINDING_MISSING",
        "EXECUTION_BINDING_MISSING",
        "EQUIVALENCE_PROOF_MISSING"
      ]
    }
  },
  "properties": {
    "reportType": { "const": "source-facts-self-governance-report.v1" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "repository": {
      "type": "object",
      "required": ["repositoryId", "workspaceId", "workspaceRoot"],
      "additionalProperties": false,
      "properties": {
        "repositoryId": { "type": "string", "minLength": 1 },
        "workspaceId": { "type": ["string", "null"] },
        "workspaceRoot": { "type": ["string", "null"] }
      }
    },
    "index": {
      "type": "object",
      "required": ["indexId", "scanId"],
      "additionalProperties": false,
      "properties": {
        "indexId": { "type": ["string", "null"] },
        "scanId": { "type": ["string", "null"] }
      }
    },
    "subjectScope": {
      "type": "object",
      "required": [
        "workspaceRelativePrefix",
        "scopeMode",
        "authorityDocumentsDiscovered",
        "authorityDocumentsInScope",
        "authorityDocumentsExcluded",
        "proposalBatchesDiscovered",
        "proposalBatchesInScope",
        "proposalBatchesExcluded",
        "featureCoverageProposalsDiscovered",
        "featureCoverageProposalsInScope",
        "featureCoverageProposalsExcluded",
        "featureCoverageInferenceEvaluationsDiscovered",
        "featureCoverageInferenceEvaluationsInScope",
        "featureCoverageInferenceEvaluationsExcluded",
        "knowHowRecordsDiscovered",
        "knowHowRecordsInScope",
        "knowHowRecordsExcluded",
        "healingDraftsDiscovered",
        "healingDraftsInScope",
        "healingDraftsExcluded"
      ],
      "additionalProperties": false,
      "properties": {
        "workspaceRelativePrefix": { "type": "string" },
        "scopeMode": { "enum": ["REPOSITORY_WIDE", "WORKSPACE_BOUNDED"] },
        "authorityDocumentsDiscovered": { "type": "integer", "minimum": 0 },
        "authorityDocumentsInScope": { "type": "integer", "minimum": 0 },
        "authorityDocumentsExcluded": { "type": "integer", "minimum": 0 },
        "proposalBatchesDiscovered": { "type": "integer", "minimum": 0 },
        "proposalBatchesInScope": { "type": "integer", "minimum": 0 },
        "proposalBatchesExcluded": { "type": "integer", "minimum": 0 },
        "featureCoverageProposalsDiscovered": { "type": "integer", "minimum": 0 },
        "featureCoverageProposalsInScope": { "type": "integer", "minimum": 0 },
        "featureCoverageProposalsExcluded": { "type": "integer", "minimum": 0 },
        "featureCoverageInferenceEvaluationsDiscovered": { "type": "integer", "minimum": 0 },
        "featureCoverageInferenceEvaluationsInScope": { "type": "integer", "minimum": 0 },
        "featureCoverageInferenceEvaluationsExcluded": { "type": "integer", "minimum": 0 },
        "knowHowRecordsDiscovered": { "type": "integer", "minimum": 0 },
        "knowHowRecordsInScope": { "type": "integer", "minimum": 0 },
        "knowHowRecordsExcluded": { "type": "integer", "minimum": 0 },
        "healingDraftsDiscovered": { "type": "integer", "minimum": 0 },
        "healingDraftsInScope": { "type": "integer", "minimum": 0 },
        "healingDraftsExcluded": { "type": "integer", "minimum": 0 }
      }
    },
    "scenarioConformance": {
      "type": "object",
      "required": ["summary", "features", "lineageAuthorityFiles"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "object" },
        "features": { "type": "array", "items": { "type": "object" } },
        "lineageAuthorityFiles": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "featureCoverage": {
      "type": "object",
      "required": ["summary", "proposals", "liveInferenceEvaluations", "uncoveredClusters", "entityCoverage"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "object" },
        "proposals": { "type": "array", "items": { "type": "object" } },
        "liveInferenceEvaluations": { "type": "array", "items": { "type": "object" } },
        "uncoveredClusters": { "type": "array", "items": { "type": "object" } },
        "entityCoverage": { "type": "object" }
      }
    },
    "unclassifiedInventory": {
      "type": "object",
      "required": [
        "mechanicsByLineageDisposition",
        "mechanicsByFeatureCoveragePosture",
        "unclassifiedAuthorityDocumentCount",
        "unclassifiedAuthorityDocuments",
        "knowHowWithoutScenarioLineage",
        "healingDraftsWithoutScenarioTarget"
      ],
      "additionalProperties": false,
      "properties": {
        "mechanicsByLineageDisposition": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "mechanicsByFeatureCoveragePosture": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "unclassifiedAuthorityDocumentCount": { "type": "integer", "minimum": 0 },
        "unclassifiedAuthorityDocuments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["authorityFile", "documentKind"],
            "additionalProperties": false,
            "properties": {
              "authorityFile": { "type": "string", "minLength": 1 },
              "documentKind": { "type": "string", "minLength": 1 }
            }
          }
        },
        "knowHowWithoutScenarioLineage": { "type": "integer", "minimum": 0 },
        "healingDraftsWithoutScenarioTarget": { "type": "integer", "minimum": 0 }
      }
    },
    "authoritySources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["authorityFile", "sourceFile", "mechanicsDeclared", "mechanicsAuthorityBound"],
        "additionalProperties": false,
        "properties": {
          "authorityFile": { "type": "string", "minLength": 1 },
          "sourceFile": { "type": ["string", "null"] },
          "mechanicsDeclared": { "type": "integer", "minimum": 0 },
          "mechanicsAuthorityBound": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "otherAuthorityDocuments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["authorityFile", "documentKind", "claimedFiles"],
        "additionalProperties": false,
        "properties": {
          "authorityFile": { "type": "string", "minLength": 1 },
          "documentKind": { "type": "string", "minLength": 1 },
          "claimedFiles": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "executionMechanics": {
      "type": "object",
      "required": ["observed", "governed", "byPosture", "byMechanicType"],
      "additionalProperties": false,
      "properties": {
        "observed": { "type": "integer", "minimum": 0 },
        "governed": { "type": "integer", "minimum": 0 },
        "byPosture": {
          "type": "object",
          "required": [
            "GOVERNED_BY_SEMANTIC_AUTHORITY",
            "MECHANICAL_ADAPTER_OPERATION",
            "KERNEL_PRIMITIVE",
            "AUTHORIZED_TEMPORARY_BACKLOG",
            "UNAUTHORIZED_EXECUTABLE_MEANING",
            "UNKNOWN_CLASSIFICATION"
          ],
          "additionalProperties": false,
          "properties": {
            "GOVERNED_BY_SEMANTIC_AUTHORITY": { "type": "integer", "minimum": 0 },
            "MECHANICAL_ADAPTER_OPERATION": { "type": "integer", "minimum": 0 },
            "KERNEL_PRIMITIVE": { "type": "integer", "minimum": 0 },
            "AUTHORIZED_TEMPORARY_BACKLOG": { "type": "integer", "minimum": 0 },
            "UNAUTHORIZED_EXECUTABLE_MEANING": { "type": "integer", "minimum": 0 },
            "UNKNOWN_CLASSIFICATION": { "type": "integer", "minimum": 0 }
          }
        },
        "byMechanicType": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["mechanic", "authorityFamily", "observed", "governed", "files", "byHomeStatus"],
            "additionalProperties": false,
            "properties": {
              "mechanic": { "type": "string", "minLength": 1 },
              "authorityFamily": { "type": "string", "minLength": 1 },
              "observed": { "type": "integer", "minimum": 0 },
              "governed": { "type": "integer", "minimum": 0 },
              "files": { "type": "integer", "minimum": 0 },
              "byHomeStatus": {
                "type": "object",
                "required": [
                  "AUTHORITY_HOME_EXISTS",
                  "AUTHORITY_HOME_EXISTS_BUT_INCOMPLETE",
                  "AUTHORITY_HOME_MISSING",
                  "AUTHORITY_HOME_AMBIGUOUS"
                ],
                "additionalProperties": false,
                "properties": {
                  "AUTHORITY_HOME_EXISTS": { "type": "integer", "minimum": 0 },
                  "AUTHORITY_HOME_EXISTS_BUT_INCOMPLETE": { "type": "integer", "minimum": 0 },
                  "AUTHORITY_HOME_MISSING": { "type": "integer", "minimum": 0 },
                  "AUTHORITY_HOME_AMBIGUOUS": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        }
      }
    },
    "dataDrivenWiring": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "modulePath",
          "importsContractData",
          "invokesSemanticRuntime",
          "transitiveContractPaths",
          "transitiveRuntimePaths",
          "hopCount",
          "hopPath",
          "wiringDisposition"
        ],
        "additionalProperties": false,
        "properties": {
          "modulePath": { "type": "string", "minLength": 1 },
          "importsContractData": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "invokesSemanticRuntime": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "transitiveContractPaths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "transitiveRuntimePaths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "hopCount": { "type": ["integer", "null"], "minimum": 1 },
          "hopPath": { "type": ["array", "null"], "items": { "type": "string", "minLength": 1 } },
          "wiringDisposition": {
            "enum": [
              "DIRECT_DATA_AND_RUNTIME",
              "RUNTIME_ONLY",
              "DATA_ONLY",
              "TRANSITIVE_DATA_AND_RUNTIME",
              "TRANSITIVE_RUNTIME_ONLY",
              "TRANSITIVE_DATA_ONLY",
              "NOT_DETERMINED_BEYOND_MAX_DEPTH",
              "NONE"
            ]
          }
        }
      }
    },
    "contractSemanticVolume": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "authorityFile",
          "documentKind",
          "semanticElementCounts",
          "totalSemanticElements",
          "reachableSemanticElements",
          "orphanedSemanticElements",
          "undeterminedSemanticElements",
          "mechanicReachability",
          "artifactReachability"
        ],
        "additionalProperties": false,
        "properties": {
          "authorityFile": { "type": "string", "minLength": 1 },
          "documentKind": { "type": "string", "minLength": 1 },
          "semanticElementCounts": {
            "type": "object",
            "required": ["decisions", "semanticEdges", "failurePolicies", "projectionMappings", "resultContracts", "responsibilities", "declarations", "mechanics"],
            "additionalProperties": false,
            "properties": {
              "decisions": { "type": "integer", "minimum": 0 },
              "semanticEdges": { "type": "integer", "minimum": 0 },
              "failurePolicies": { "type": "integer", "minimum": 0 },
              "projectionMappings": { "type": "integer", "minimum": 0 },
              "resultContracts": { "type": "integer", "minimum": 0 },
              "responsibilities": { "type": "integer", "minimum": 0 },
              "declarations": { "type": "integer", "minimum": 0 },
              "mechanics": { "type": "integer", "minimum": 0 }
            }
          },
          "totalSemanticElements": { "type": "integer", "minimum": 0 },
          "reachableSemanticElements": { "type": "integer", "minimum": 0 },
          "orphanedSemanticElements": { "type": "integer", "minimum": 0 },
          "undeterminedSemanticElements": { "type": "integer", "minimum": 0 },
          "mechanicReachability": {
            "type": ["object", "null"],
            "required": ["total", "resolved", "unresolved", "ambiguous", "byStatus"],
            "additionalProperties": false,
            "properties": {
              "total": { "type": "integer", "minimum": 0 },
              "resolved": { "type": "integer", "minimum": 0 },
              "unresolved": { "type": "integer", "minimum": 0 },
              "ambiguous": { "type": "integer", "minimum": 0 },
              "byStatus": {
                "type": "object",
                "required": ["RESOLVED", "RESOLVED_BY_SUFFIX", "MOVED_OR_REMOVED", "AMBIGUOUS", "UNRESOLVABLE_LOCATION"],
                "additionalProperties": false,
                "properties": {
                  "RESOLVED": { "type": "integer", "minimum": 0 },
                  "RESOLVED_BY_SUFFIX": { "type": "integer", "minimum": 0 },
                  "MOVED_OR_REMOVED": { "type": "integer", "minimum": 0 },
                  "AMBIGUOUS": { "type": "integer", "minimum": 0 },
                  "UNRESOLVABLE_LOCATION": { "type": "integer", "minimum": 0 }
                }
              }
            }
          },
          "artifactReachability": {
            "type": ["array", "null"],
            "items": {
              "type": "object",
              "required": ["artifactId", "relativePath", "reachable", "semanticElementCount"],
              "additionalProperties": false,
              "properties": {
                "artifactId": { "type": ["string", "null"] },
                "relativePath": { "type": ["string", "null"] },
                "reachable": { "type": "boolean" },
                "semanticElementCount": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "authoritySuccession": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "authorityFile",
          "declaredSourceFile",
          "anchorFile",
          "succession",
          "successorFile",
          "hopCount",
          "mechanicsDeclared",
          "mechanicsPresentInSuccessor",
          "recommendedAction"
        ],
        "additionalProperties": false,
        "properties": {
          "authorityFile": { "type": "string", "minLength": 1 },
          "declaredSourceFile": { "type": "string", "minLength": 1 },
          "anchorFile": { "type": ["string", "null"] },
          "succession": {
            "enum": [
              "AUTHORITY_SOURCE_STILL_CURRENT",
              "AUTHORITY_SOURCE_CURRENT_BUT_INCOMPLETE",
              "AUTHORITY_SUCCESSOR_RESOLVED",
              "AUTHORITY_SUCCESSOR_PARTIAL",
              "AUTHORITY_SUCCESSOR_RESOLVED_NO_MECHANIC_OVERLAP",
              "AUTHORITY_SUCCESSOR_AMBIGUOUS",
              "AUTHORITY_SUCCESSOR_NOT_DETERMINED_BEYOND_MAX_DEPTH",
              "AUTHORITY_HAS_NO_CURRENT_SUCCESSOR"
            ]
          },
          "successorFile": { "type": ["string", "null"] },
          "hopCount": { "type": ["integer", "null"], "minimum": 1 },
          "mechanicsDeclared": { "type": "integer", "minimum": 1 },
          "mechanicsPresentInSuccessor": { "type": "integer", "minimum": 0 },
          "recommendedAction": {
            "enum": [
              "NONE_ALREADY_CURRENT",
              "REVIEW_SOURCE_FOR_MISSING_MECHANIC_TYPES",
              "REVIEW_AND_REBIND_TO_SUCCESSOR",
              "REVIEW_PARTIAL_SUCCESSOR_AND_AUTHOR_GAPS",
              "RECONCILE_MANUALLY_LOW_CONFIDENCE",
              "RECONCILE_MANUALLY_AMBIGUOUS_SUCCESSOR",
              "RECONCILE_MANUALLY_NO_SUCCESSOR",
              "RECONCILE_MANUALLY_NO_ANCHOR"
            ]
          }
        }
      }
    },
    "semanticOverlapProposals": {
      "type": "array",
      "description": "Agent-inferred, human-reviewed proposals discovered from reviews/ (never contracts/). Never governance evidence -- purely observational alongside the deterministic findings.",
      "items": {
        "type": "object",
        "required": [
          "proposalFile",
          "lifecycle",
          "historicalAuthorityFile",
          "resolvedSuccessorFile",
          "inferenceModel",
          "inferredAtUtc",
          "totalProposed",
          "modelDispositionCounts",
          "reviewedDispositionCounts",
          "reviewFindings",
          "inferenceQuality"
        ],
        "additionalProperties": false,
        "properties": {
          "proposalFile": { "type": "string", "minLength": 1 },
          "lifecycle": { "type": "string", "minLength": 1 },
          "historicalAuthorityFile": { "type": ["string", "null"] },
          "resolvedSuccessorFile": { "type": ["string", "null"] },
          "inferenceModel": { "type": ["string", "null"] },
          "inferredAtUtc": { "type": ["string", "null"] },
          "totalProposed": { "type": "integer", "minimum": 0 },
          "modelDispositionCounts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
          "reviewedDispositionCounts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
          "reviewFindings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["authorityMechanicId", "reviewVerdict", "correctedDisposition", "reason"],
              "additionalProperties": false,
              "properties": {
                "authorityMechanicId": { "type": ["string", "null"] },
                "reviewVerdict": { "type": ["string", "null"] },
                "correctedDisposition": { "type": ["string", "null"] },
                "reason": { "type": ["string", "null"] }
              }
            }
          },
          "inferenceQuality": {
            "type": "object",
            "description": "Not a benchmark of the model -- a benchmark of how efficiently this review converted candidate understanding into admitted knowledge.",
            "required": [
              "proposalsGenerated",
              "reviewOutcomeCounts",
              "unrecordedOutcomes",
              "modelConfidenceAverage",
              "reviewedConfidenceAverage",
              "newDeterministicFindingsFromReview",
              "knowHowExtracted",
              "candidateAuthorities"
            ],
            "additionalProperties": false,
            "properties": {
              "proposalsGenerated": { "type": "integer", "minimum": 0 },
              "reviewOutcomeCounts": {
                "type": "object",
                "required": ["APPROVED_UNCHANGED", "AMENDED", "APPROVED_WITH_ADDITIONAL_FINDING", "REJECTED"],
                "additionalProperties": false,
                "properties": {
                  "APPROVED_UNCHANGED": { "type": "integer", "minimum": 0 },
                  "AMENDED": { "type": "integer", "minimum": 0 },
                  "APPROVED_WITH_ADDITIONAL_FINDING": { "type": "integer", "minimum": 0 },
                  "REJECTED": { "type": "integer", "minimum": 0 }
                }
              },
              "unrecordedOutcomes": { "type": "integer", "minimum": 0 },
              "modelConfidenceAverage": { "type": ["number", "null"] },
              "reviewedConfidenceAverage": { "type": ["number", "null"] },
              "newDeterministicFindingsFromReview": { "type": "integer", "minimum": 0 },
              "knowHowExtracted": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["knowHowId", "statement", "kind", "generalizability", "reviewFinding", "supportingSubjects"],
                  "additionalProperties": false,
                  "properties": {
                    "knowHowId": { "type": ["string", "null"] },
                    "statement": { "type": "string" },
                    "kind": { "type": "string", "minLength": 1 },
                    "generalizability": { "type": "string", "minLength": 1 },
                    "reviewFinding": { "type": ["string", "null"] },
                    "supportingSubjects": { "type": "array", "items": { "type": "string" } }
                  }
                }
              },
              "candidateAuthorities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["candidateAuthorityId", "family", "rationale"],
                  "additionalProperties": false,
                  "properties": {
                    "candidateAuthorityId": { "type": ["string", "null"] },
                    "family": { "type": ["string", "null"] },
                    "rationale": { "type": ["string", "null"] }
                  }
                }
              }
            }
          }
        }
      }
    },
    "knowHowRegistry": {
      "type": "object",
      "description": "Durable, admitted know-how and authority-remediation candidates discovered from know-how/ (distinct from reviews/, which holds not-yet-admitted proposals). Purely descriptive -- never governance evidence.",
      "required": ["admittedKnowHowCount", "byKind", "byGeneralizability", "knowHowRecords", "authorityRemediationCandidateCount", "authorityRemediationCandidates"],
      "additionalProperties": false,
      "properties": {
        "admittedKnowHowCount": { "type": "integer", "minimum": 0 },
        "byKind": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "byGeneralizability": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "knowHowRecords": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["recordFile", "knowHowId", "lifecycle", "kind", "generalizability", "statement", "inferenceBatch"],
            "additionalProperties": false,
            "properties": {
              "recordFile": { "type": "string", "minLength": 1 },
              "knowHowId": { "type": ["string", "null"] },
              "lifecycle": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "minLength": 1 },
              "generalizability": { "type": "string", "minLength": 1 },
              "statement": { "type": "string" },
              "inferenceBatch": { "type": ["string", "null"] }
            }
          }
        },
        "authorityRemediationCandidateCount": { "type": "integer", "minimum": 0 },
        "authorityRemediationCandidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["recordFile", "candidateAuthorityId", "lifecycle", "family", "rationale", "citesKnowHow"],
            "additionalProperties": false,
            "properties": {
              "recordFile": { "type": "string", "minLength": 1 },
              "candidateAuthorityId": { "type": ["string", "null"] },
              "lifecycle": { "type": "string", "minLength": 1 },
              "family": { "type": ["string", "null"] },
              "rationale": { "type": "string" },
              "citesKnowHow": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "healingDraftRegistry": {
      "type": "object",
      "description": "Review-only connective-tissue drafts discovered from healing/ (distinct from reviews/ and know-how/). Purely descriptive -- never authority, never applied source, never governance evidence.",
      "required": ["totalDrafts", "byDisposition", "byTissueType", "drafts"],
      "additionalProperties": false,
      "properties": {
        "totalDrafts": { "type": "integer", "minimum": 0 },
        "byDisposition": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "byTissueType": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "drafts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "draftFile",
              "lifecycle",
              "subjectId",
              "scenarioTarget",
              "healingDisposition",
              "confidence",
              "missingTissue",
              "generatedTissueTypes",
              "inferenceModel"
            ],
            "additionalProperties": false,
            "properties": {
              "draftFile": { "type": "string", "minLength": 1 },
              "lifecycle": { "type": "string", "minLength": 1 },
              "subjectId": { "type": ["string", "null"] },
              "scenarioTarget": { "type": ["object", "null"] },
              "healingDisposition": { "type": "string", "minLength": 1 },
              "confidence": { "type": ["number", "null"] },
              "missingTissue": { "type": "array", "items": { "type": "string" } },
              "generatedTissueTypes": { "type": "array", "items": { "type": "string" } },
              "inferenceModel": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "automationReadiness": {
      "type": "object",
      "required": ["byDisposition"],
      "additionalProperties": false,
      "properties": {
        "byDisposition": {
          "type": "object",
          "required": [
            "ALREADY_GOVERNED",
            "NOT_APPLICABLE",
            "AUTOMATABLE_AFTER_REVIEW",
            "REQUIRES_HUMAN_SEMANTIC_DECISION",
            "AUTOMATABLE_AFTER_AUTHORITY_COMPLETION",
            "REQUIRES_NEW_AUTHORITY",
            "NOT_CURRENTLY_PROJECTABLE"
          ],
          "additionalProperties": false,
          "properties": {
            "ALREADY_GOVERNED": { "type": "integer", "minimum": 0 },
            "NOT_APPLICABLE": { "type": "integer", "minimum": 0 },
            "AUTOMATABLE_AFTER_REVIEW": { "type": "integer", "minimum": 0 },
            "REQUIRES_HUMAN_SEMANTIC_DECISION": { "type": "integer", "minimum": 0 },
            "AUTOMATABLE_AFTER_AUTHORITY_COMPLETION": { "type": "integer", "minimum": 0 },
            "REQUIRES_NEW_AUTHORITY": { "type": "integer", "minimum": 0 },
            "NOT_CURRENTLY_PROJECTABLE": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "fileBreakdown": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["mechanic", "modulePath", "authorityFamily", "occurrenceCount", "governedCount", "responsibilities", "homeStatus", "authorityFile", "authorityHomeVerified"],
        "additionalProperties": false,
        "properties": {
          "mechanic": { "type": "string", "minLength": 1 },
          "modulePath": { "type": "string", "minLength": 1 },
          "authorityFamily": { "type": "string", "minLength": 1 },
          "occurrenceCount": { "type": "integer", "minimum": 1 },
          "governedCount": { "type": "integer", "minimum": 0 },
          "responsibilities": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "homeStatus": { "$ref": "#/$defs/authorityHomeStatus" },
          "authorityFile": { "type": ["string", "null"] },
          "authorityHomeVerified": { "type": "boolean" }
        }
      }
    },
    "occurrences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "mechanic",
          "modulePath",
          "startLine",
          "endLine",
          "symbolName",
          "posture",
          "governingMechanicId",
          "governingAuthorityFile",
          "authorityFamily",
          "authorityHomeStatus",
          "authorityHomeFile",
          "authorityHomeVerified",
          "automationDisposition",
          "missingTissue",
          "candidateAuthorityFile",
          "candidateMechanicId",
          "candidateCoverageDisposition",
          "lineageDisposition",
          "featureClassificationIds",
          "featureIds",
          "scenarioIds",
          "obligationIds",
          "lineageResponsibilityIds",
          "featureCoveragePosture"
        ],
        "additionalProperties": false,
        "properties": {
          "mechanic": { "type": "string", "minLength": 1 },
          "modulePath": { "type": "string" },
          "startLine": { "type": ["integer", "null"] },
          "endLine": { "type": ["integer", "null"] },
          "symbolName": { "type": ["string", "null"] },
          "posture": { "$ref": "#/$defs/posture" },
          "governingMechanicId": { "type": ["string", "null"] },
          "governingAuthorityFile": { "type": ["string", "null"] },
          "authorityFamily": { "type": "string", "minLength": 1 },
          "authorityHomeStatus": { "$ref": "#/$defs/authorityHomeStatus" },
          "authorityHomeFile": { "type": ["string", "null"] },
          "authorityHomeVerified": { "type": "boolean" },
          "automationDisposition": { "$ref": "#/$defs/automationDisposition" },
          "missingTissue": { "type": "array", "items": { "$ref": "#/$defs/missingTissue" } },
          "candidateAuthorityFile": { "type": ["string", "null"] },
          "candidateMechanicId": { "type": ["string", "null"] },
          "candidateCoverageDisposition": { "type": ["string", "null"] },
          "lineageDisposition": {
            "enum": [
              "LINEAGE_CONFIRMED",
              "LINEAGE_INFERRED_PENDING_REVIEW",
              "MULTIPLE_CANDIDATE_SCENARIOS",
              "NO_SCENARIO_LINEAGE",
              "CROSS_CUTTING_PLATFORM_RESPONSIBILITY",
              "POLLUTION_OR_ORPHAN"
            ]
          },
          "featureClassificationIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "featureIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "scenarioIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "obligationIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "lineageResponsibilityIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "featureCoveragePosture": {
            "enum": [
              "FEATURE_COVERED",
              "FEATURE_COVERAGE_PROPOSED",
              "FEATURE_LINEAGE_AMBIGUOUS",
              "FEATURE_COVERAGE_MISSING"
            ]
          }
        }
      }
    },
    "queryLineage": {
      "type": "object",
      "required": ["documentKind", "invariant", "catalog", "registeredQueries", "queryReceipts", "claims", "reconciliation"],
      "additionalProperties": false,
      "properties": {
        "documentKind": { "const": "source-facts-report-query-lineage.v1" },
        "invariant": { "const": "EVERY_RENDERED_FACT_HAS_INSPECTABLE_QUERY_RESULT" },
        "catalog": {
          "type": "object",
          "required": ["catalogId", "catalogVersion", "catalogHash"],
          "additionalProperties": false,
          "properties": {
            "catalogId": { "const": "self-governance-query-catalog.v1" },
            "catalogVersion": { "const": "1.0.0" },
            "catalogHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        },
        "registeredQueries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["queryId", "section", "queryText", "inputCollections", "expectedResultSchema", "queryVersion", "scopePolicy", "queryHash"],
            "additionalProperties": false,
            "properties": {
              "queryId": { "type": "string", "minLength": 1 },
              "section": { "type": "string", "minLength": 1 },
              "queryText": { "type": "string", "minLength": 1 },
              "inputCollections": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "expectedResultSchema": { "type": "string", "minLength": 1 },
              "queryVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
              "scopePolicy": { "type": "string", "minLength": 1 },
              "queryHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            }
          }
        },
        "queryReceipts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["documentKind", "queryId", "queryVersion", "queryHash", "index", "execution", "result"],
            "additionalProperties": false,
            "properties": {
              "documentKind": { "const": "source-facts-query-receipt.v1" },
              "queryId": { "type": "string", "minLength": 1 },
              "queryVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
              "queryHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "index": {
                "type": "object",
                "required": ["indexId", "scanId"],
                "additionalProperties": false,
                "properties": {
                  "indexId": { "type": ["string", "null"] },
                  "scanId": { "type": ["string", "null"] }
                }
              },
              "execution": {
                "type": "object",
                "required": ["disposition", "rowCount", "resultHash"],
                "additionalProperties": false,
                "properties": {
                  "disposition": { "const": "RELATIONAL_QUERY_EXECUTED" },
                  "rowCount": { "type": "integer", "minimum": 0 },
                  "resultHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
                }
              },
              "result": {
                "type": "object",
                "required": ["rows"],
                "additionalProperties": false,
                "properties": { "rows": { "type": "array" } }
              }
            }
          }
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["claimId", "claimType", "queryId", "reportPointer", "valuePointer"],
            "additionalProperties": false,
            "properties": {
              "claimId": { "type": "string", "minLength": 1 },
              "claimType": { "enum": ["DIRECT_FACT", "DERIVED_METRIC", "CLASSIFICATION", "INFERENCE", "HUMAN_REVIEWED_AUTHORITY"] },
              "queryId": { "type": "string", "minLength": 1 },
              "reportPointer": { "type": "string", "pattern": "^/" },
              "valuePointer": { "type": "string", "pattern": "^/" }
            }
          }
        },
        "reconciliation": {
          "type": "object",
          "required": [
            "disposition", "claimCount", "claimsWithQueryPointers", "missingQueryPointers",
            "unsupportedFactualClaims", "staleReceipts", "indexMismatches", "scopeMismatches",
            "resultShapeFailures", "resultHashFailures", "renderedValueMismatches",
            "deterministicRerunMismatches", "receiptsExecuted", "receiptsValid"
          ],
          "additionalProperties": false,
          "properties": {
            "disposition": { "const": "PASSED" },
            "claimCount": { "type": "integer", "minimum": 1 },
            "claimsWithQueryPointers": { "type": "integer", "minimum": 1 },
            "missingQueryPointers": { "const": 0 },
            "unsupportedFactualClaims": { "const": 0 },
            "staleReceipts": { "const": 0 },
            "indexMismatches": { "const": 0 },
            "scopeMismatches": { "const": 0 },
            "resultShapeFailures": { "const": 0 },
            "resultHashFailures": { "const": 0 },
            "renderedValueMismatches": { "const": 0 },
            "deterministicRerunMismatches": { "const": 0 },
            "receiptsExecuted": { "type": "integer", "minimum": 1 },
            "receiptsValid": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "disposition": { "const": "OBSERVATIONAL_NO_GATE_APPLIED" }
  }
}
