{
  "name": "source-facts-semantic-search-engine",
  "version": "0.1.0",
  "description": "MVP source-facts semantic search engine.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "source-facts-se": "./src/cli.js"
  },
  "scripts": {
    "project": "node src/cli.js project",
    "query": "node src/cli.js query",
    "call-graph": "node src/cli.js call-graph",
    "generate-docs": "node src/cli.js generate-docs",
    "govern": "node src/cli.js govern",
    "sync-self-governance": "node src/cli.js sync-self-governance",
    "draft-capability": "node src/cli.js draft-capability",
    "start": "node src/cli.js",
    "build": "npm run gate:workspace",
    "check:deps": "node ./scripts/check-deps.mjs",
    "test": "npm run gate:workspace && node --test test",
    "prove:smoke": "node ./scripts/prove-smoke.mjs",
    "prove:smoke:web": "node ./scripts/prove-smoke-web.mjs",
    "gate:workspace": "workspace-fs evaluate --contract ./contracts/workspace-file-system.contract.json"
  },
  "dependencies": {
    "@deterministic-solutions/sej-runtime-query": "file:../sej-runtime-query",
    "@deterministic-solutions/semantic-kernel": "file:../semantic-kernel",
    "@deterministic-solutions/source-code-taxonomy-scanner": "file:../source-code-taxonomy-scanner",
    "@deterministic-solutions/workspace-file-system-governor": "file:../workspace-file-system-governor",
    "ajv": "^8.17.1",
    "playwright": "^1.48.0",
    "typescript": "^5.8.3",
    "webpage-classification-scanner": "file:../webpage-classification-scanner"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  }
}
